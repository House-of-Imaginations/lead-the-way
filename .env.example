# ---------------------------------------------------------------------------
# Next.js env (.env.local). Public values only -- anything here reaches the browser
# if prefixed NEXT_PUBLIC_. Real secrets live in the Convex deployment env instead,
# because Better Auth and every provider call run inside Convex.
# ---------------------------------------------------------------------------

# The local backend from docker-compose.yml. Get the key from
# `docker compose exec backend ./generate_admin_key.sh`; a `docker compose down -v`
# wipes the database and invalidates it.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# For a cloud deployment instead, clear the two above and let `npx convex dev` write this
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# The HTTP actions origin: port 3211 locally, or the same subdomain as
# NEXT_PUBLIC_CONVEX_URL ending .site instead of .cloud on a cloud deployment
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# Convex deployment env -- NOT this file. Set with `npx convex env set <NAME> <value>`
#
#   BETTER_AUTH_SECRET      openssl rand -base64 32
#   SITE_URL                http://localhost:3000
#   GOOGLE_CLIENT_ID        OAuth client (Google Cloud Console)
#   GOOGLE_CLIENT_SECRET
#   DISCORD_CLIENT_ID       OAuth app (Discord Developer Portal)
#   DISCORD_CLIENT_SECRET
#   OPENAI_API_KEY          optional: the notes.ts example action
#   PRESENCE=on     # Convex env: who-is-here heartbeats; off unless a surface reads them
#
#   VAPID_PUBLIC_KEY        npx web-push generate-vapid-keys
#   VAPID_PRIVATE_KEY       the other half of the same pair
#
# The OAuth pairs are optional: `convex/auth.ts` registers a provider only when
# both halves are present, so email/username sign-in works before the OAuth apps
# exist and the buttons start working with no code change.
#
# Both halves of the VAPID pair live in the Convex deployment env, never here
# and never in the repository. The public half is served to the browser by
# `api.push.publicKey` rather than baked in as a NEXT_PUBLIC_ variable, so the
# pair is set and rotated in one place. With neither set, push self-disables:
# the settings screen says so and nothing is ever sent.
# ---------------------------------------------------------------------------
