# ---------------------------------------------------------------------------
# Next.js env (.env.local). Public values only -- anything here reaches the browser
# if prefixed NEXT_PUBLIC_. Real secrets live in the Convex deployment env instead,
# because Better Auth and every provider call run inside Convex.
# ---------------------------------------------------------------------------

# Only for the optional docker-compose.yml backend. Uncomment both to use it:
# get the key from `docker compose exec backend ./generate_admin_key.sh`; a
# `docker compose down -v` wipes the database and invalidates it.
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=

# For a cloud deployment instead, leave the two above unset and let `npx convex dev` write this
CONVEX_DEPLOYMENT=

# `npx convex dev` writes this once it selects or creates a deployment.
NEXT_PUBLIC_CONVEX_URL=

# `npx convex dev` does not write this one; add it by hand.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Required for the /login demo picker: the same DEMO_PASSWORD as the Convex env.
# Without it the picker can't sign anybody in. The picker signs in with it on the
# server (set it in the hosting env too, matching the Convex prod value), and
# e2e/demo.ts uses it to sign in as a persona; left out, e2e asks Convex
# (`pnpm exec convex env get`). Never commit it.
# DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Convex deployment env: NOT this file. Set with `npx convex env set <NAME> <value>`.
#
#   BETTER_AUTH_SECRET      openssl rand -base64 32
#   SITE_URL                http://localhost:3000
#   APP_CLOSED              kill switch; on closes the app to everything but the landing page
#   DEMO_MODE                on   (seeded Calder Lane, persona switch, demo clock) -- from P2
#   DEMO_PASSWORD           shared password for the demo accounts, 12+ characters -- from P2
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET     optional social sign-in
#   GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET     optional social sign-in
#   DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET   optional social sign-in
#   RESEND_API_KEY / RESEND_FROM                optional; without them nothing is emailed
#                                               and invitations show copyable links
#
# A social provider is registered only when both halves of its pair are set.
# ---------------------------------------------------------------------------
