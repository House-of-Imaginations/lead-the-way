# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the documented template in version control
!.env.example

# AI
# Agent skills are committed; only the machine-local permission file is not
.claude/settings.local.json
.omc/
.omx/
.code-review-graph/

# Tests
.playwright-cli/
.playwright/
output/

# OCR language data for local LiteParse checks (install into Convex with scripts/install-ocr-assets.mjs)
/.ocr/

# Worktrees
.worktrees/

# Playwright
/test-results/
/playwright-report/
/e2e/.auth/
